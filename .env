# LOCAL ONLY — never commit this file (it's gitignored). Real secrets live here.
#
# For local dev, either:
#   (a) point AZURE_KEY_VAULT_NAME at a dev vault you have access to, or
#   (b) temporarily hardcode a local DATABASE_URL in server.js while
#       developing offline, then revert before committing.
# Production never uses a .env file — all secrets are fetched from
# Azure Key Vault at runtime (see src/config/keyvault.js).

# --- Postgres (your local EDB install) ---
DATABASE_URL="postgresql://merch_user:localdevpassword@localhost:5432/merch_store"
JWT_SECRET=dev-only-change-me
AI_API_KEY=dev-placeholder-ai-key
EDUCORE_API_KEY=dev-placeholder-educore-key
EDUCORE_INBOUND_KEY=dev-shared-secret-for-educore-team

# --- Azure Key Vault (real values — set, so keyvault.js uses these instead of the fallback above) ---
AZURE_KEY_VAULT_NAME=bad-kv
AZURE_CLIENT_ID=bc1f4e2d-22b0-4f0d-8ef8-5a4ff98279e4
AZURE_TENANT_ID=c60e2bb9-4518-4d60-8f5d-c715fc9a04bf
AZURE_CLIENT_SECRET=<ROTATE-THIS-THEN-PASTE-NEW-VALUE-HERE>

AD_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
AD_CLIENT_ID=<app-registration-client-id>
AD_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

EDUCORE_BASE_URL=https://your-domain.com/educore

PORT=3000