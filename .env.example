# Copy this to .env and fill in values. .env is gitignored — every teammate
# keeps their own copy; never commit real secrets.
#
# Production never uses a .env file — all secrets are fetched from Azure Key
# Vault at runtime (see src/config/keyvault.js). Locally/for the team, leave
# AZURE_KEY_VAULT_NAME blank and fill in the plain secret vars below instead —
# keyvault.js falls back to reading them straight from the environment.

# --- Postgres (used by the `db` service in docker-compose.yml) ---
POSTGRES_USER=merchstore
POSTGRES_PASSWORD=merchstore
POSTGRES_DB=merchstore
# Host-side port the `db` container is published on. Defaults to 5433 since
# 5432 is often already taken by a Postgres install on your machine — change
# this (not the DATABASE_URL port below) if 5433 is also taken.
POSTGRES_HOST_PORT=5433

# --- Local/team dev secrets (leave AZURE_KEY_VAULT_NAME below blank to use these) ---
# Used when running `npm run dev` directly on the host; must match POSTGRES_HOST_PORT.
DATABASE_URL=postgresql://merchstore:merchstore@localhost:5433/merchstore
JWT_SECRET=dev-only-change-me
# All five vars below must be non-empty for the server to boot (see
# src/config/keyvault.js) — these placeholders are enough to start the app;
# swap in a real key only when you actually need that integration to work
# (AI-generated descriptions / a real EduCore call).
AI_API_KEY=dev-placeholder-ai-key
EDUCORE_API_KEY=dev-placeholder-educore-key
EDUCORE_INBOUND_KEY=dev-shared-secret-for-educore-team

# --- Azure Key Vault (leave blank for local/team dev; required in production) ---
# NEVER put real values here — this file is committed to git. Put real
# credentials in your own .env instead (gitignored, never committed).
AZURE_KEY_VAULT_NAME=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

AD_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
AD_CLIENT_ID=<app-registration-client-id>
AD_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

EDUCORE_BASE_URL=https://your-domain.com/educore

PORT=3000
