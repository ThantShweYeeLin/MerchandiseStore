# LOCAL DEVELOPMENT ONLY. Production never uses a .env file — all secrets are
# fetched from Azure Key Vault at runtime (see src/config/keyvault.js).
#
# For local dev, either:
#   (a) point AZURE_KEY_VAULT_NAME at a dev vault you have access to, or
#   (b) temporarily hardcode a local DATABASE_URL in server.js while
#       developing offline, then revert before committing.

AZURE_KEY_VAULT_NAME=class-merch-store-dev
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

AD_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
AD_CLIENT_ID=<app-registration-client-id>
AD_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

EDUCORE_BASE_URL=https://your-domain.com/educore

PORT=3000
